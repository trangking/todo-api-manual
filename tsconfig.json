{
  "compilerOptions": {
    /* 🌍 Environment */
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",

    /* 📂 Structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* ⚙️ Options */
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"],
    "noImplicitAny": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
